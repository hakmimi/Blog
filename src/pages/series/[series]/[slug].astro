---
import { render } from 'astro:content';
import ArticleLayout from '../../../layouts/ArticleLayout.astro';
import { getArticles } from '../../../lib/content';

export async function getStaticPaths() {
  const all = await getArticles();
  return all.map((entry) => {
    const siblings = all.filter((a) => a.data.series === entry.data.series).sort((a, b) => a.data.order - b.data.order);
    const i = siblings.findIndex((a) => a.id === entry.id);
    return {
      params: { series: entry.data.series, slug: entry.id.split('/').pop() },
      props: { entry, siblings, prev: siblings[i - 1], next: siblings[i + 1] },
    };
  });
}
const { entry, prev, next, siblings } = Astro.props;
const { Content } = await render(entry);
---
<ArticleLayout {entry} {prev} {next} {siblings}><Content /></ArticleLayout>
