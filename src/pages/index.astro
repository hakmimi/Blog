---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getPostsByArticleDate } from "@/utils/getPostsByArticleDate";
import { SOURCES, type SourceKey } from "@/utils/sources";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const posts = getPostsByArticleDate(await getCollection("posts"));
const homePath = getRelativeLocaleUrl(locale, "");

// How many posts test each company's articles, most first.
const counts = new Map<SourceKey, number>();
for (const p of posts) for (const s of p.data.source) counts.set(s, (counts.get(s) ?? 0) + 1);
const companies = [...counts.entries()].sort((a, b) => b[1] - a[1]);
const labUrl = "https://github.com/hakmimi/ai-engineering-lab";
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout-wide my-1"
  >
    <div class="grid gap-x-12 md:grid-cols-[minmax(0,1fr)_15rem]">
      <div>
        <section id="hero" class="pt-10 pb-6">
          <!-- TODO(Yitzhak): the intro is a draft; put it in your own words. -->
          <h1 class="text-3xl leading-tight font-extrabold tracking-tight sm:text-4xl">
            I test what AI companies{" "}
            <span class="from-accent to-accent-2 bg-linear-to-r bg-clip-text text-transparent">say works</span>.
          </h1>
          <p class="text-muted-foreground mt-3 text-lg">
            Real claims from engineering blogs, checked on public benchmarks.
            <a
              target="_blank"
              href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
              class="ms-1 inline-block align-middle"
              aria-label="RSS Feed"
              title="RSS Feed"
            >
              <IconRss width={18} height={18} class="stroke-accent stroke-3" />
            </a>
          </p>
        </section>

        <section id="posts" class="pb-10">
          <ul>
            {posts.map(post => <Card variant="h2" {...post} />)}
          </ul>
        </section>
      </div>

      <aside class="border-border text-muted-foreground space-y-7 pb-10 text-sm max-md:border-t max-md:pt-8 md:border-s md:ps-8 md:pt-12">
        <div>
          <div class="from-accent to-accent-2 mb-3 size-11 rounded-full bg-linear-to-br"></div>
          <h2 class="text-foreground mb-1.5 font-semibold">About</h2>
          <!-- TODO(Yitzhak): a line about you. -->
          <p>I take claims from company engineering posts and test them on public data. The code and every number are on GitHub.</p>
        </div>
        <div>
          <h2 class="text-foreground mb-2 font-semibold">Companies tested</h2>
          <ul class="flex flex-wrap gap-1.5">
            {companies.map(([key, n]) => (
              <li class="bg-accent-soft text-accent rounded-full px-2.5 py-0.5 text-xs font-semibold">
                {SOURCES[key].name}{n > 1 && ` · ${n}`}
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h2 class="text-foreground mb-1.5 font-semibold">Timeline</h2>
          <p>Every post placed by the year its article came out.</p>
          <a href={getRelativeLocaleUrl(locale, "timeline")} class="text-accent mt-1 inline-block font-semibold hover:underline">Open the timeline →</a>
        </div>
        <div>
          <h2 class="text-foreground mb-1.5 font-semibold">Code</h2>
          <a href={labUrl} class="text-accent font-semibold hover:underline">ai-engineering-lab on GitHub →</a>
        </div>
      </aside>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
