---
// The article(s) a post tests, with the month each came out. Plain text on cards, links on the post page.
type Article = { publisher: string; title: string; url: string; date: Date };
type Props = { articles?: Article[]; size?: "sm" | "lg" };

const { articles = [], size = "sm" } = Astro.props;
const month = new Intl.DateTimeFormat("en", { month: "short", year: "numeric", timeZone: "UTC" });
---

{
  articles.length > 0 && (
    <p class:list={["text-muted-foreground text-sm", { "sm:text-base": size === "lg" }]}>
      <span>Tests </span>
      {articles.map((a, i) => (
        <>
          {i > 0 && <span> and </span>}
          {size === "lg" ? (
            <a href={a.url} class="hover:text-accent underline decoration-dashed underline-offset-4">
              {a.publisher}: {a.title}
            </a>
          ) : (
            <span>{a.publisher}</span>
          )}
          <span> ({month.format(a.date)})</span>
        </>
      ))}
    </p>
  )
}
