---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import SourceLogos from "./SourceLogos.astro";
import ArticleInfo from "./ArticleInfo.astro";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;

const { title, description, source, articles } = data;
---

<li class="border-border border-t py-5 first:border-t-0">
  <a
    href={getPostUrl(id, filePath, Astro.currentLocale)}
    class="group flex items-start justify-between gap-4"
  >
    <Heading
      transition:name={toTransitionName(id)}
      class="group-hover:text-accent text-lg leading-snug font-semibold tracking-tight transition-colors"
    >
      {title}
    </Heading>
    <SourceLogos sources={source} />
  </a>
  {/* Publish dates are hidden; the article's month shows instead. */}
  <p class="text-muted-foreground mt-1.5 line-clamp-3 text-[0.95rem] leading-relaxed">{description}</p>
  <div class="mt-2">
    <ArticleInfo articles={articles} />
  </div>
</li>
