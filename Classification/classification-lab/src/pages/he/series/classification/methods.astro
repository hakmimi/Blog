---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { base } from '../../../../lib/content';
const cards = [
  ['החלטה', 'מדרגים שיחות מתוכננות רגע לפני שהן מתבצעות. רק מידע שקיים ברגע הזה יכול להיות תכונה.'],
  ['רשומות', 'שורה אחת היא רשומה אחת. בקובץ אין מזהה לקוח, ולכן אף פעם לא קוראים לרשומות לקוחות שונים.'],
  ['תכונות', '18 עמודות עיקריות. duration מוחרגת (לא ידועה לפני השיחה) ו-campaign מוחרגת (אי אפשר לבסס את הזכאות שלה); שתיהן נבדקות מחדש בהרצות רגישות.'],
  ['תפקידי הנתונים', 'פיתוח (80%, גרעין 42, שכבתי) לכל בחירה, השוואה (20%) שמדורגת פעם אחת עבור תהליכים קפואים, וחלוקה כרונולוגית (80% הראשונים של השורות / 20% האחרונים) לחלק 16.'],
  ['פרוטוקול חיפוש', 'ברירת מחדל ועוד עד שבעה מועמדים אקראיים לכל מודל, הצלבה של 3 קיפולים עם ערבוב על שורות הפיתוח, מדורגת לפי דיוק ממוצע. מספרי המועמדים נמדדים ולא מונחים.'],
  ['רשימת מחירים', 'עלות 1 לכל שיחה, ערך 8 לכל הרשמה: הנחות להמחשה. התרומות הן סימולציות מדיניות רטרוספקטיביות, לא ערך שנוצר מההתקשרות.'],
  ['דיווח', 'דיוק ממוצע, AUC, log loss, Brier, ECE עם ספירות, תרומה מדומה מול קווי בסיס, בוטסטראפ מזווג עם רווחים סימולטניים.'],
  ['המסלול הסינתטי', 'מעבדת הפירות: גורם מבוקר אחד משתנה בכל פעם; גרעין אקראי קבוע 20260930.'],
];
const art = (f) => `${import.meta.env.BASE_URL}series/classification/artifacts/${f}`;
const alt = { lang: 'en', href: `${base}/series/classification/methods/` };
---
<BaseLayout lang="he" alt={alt} title="שיטות">
  <section class="section prose" dir="rtl">
    <p class="eyebrow">שיטות במבט אחד</p>
    <h1>פרוטוקול אחד, הנחות גלויות</h1>
    <p class="lede">הבחירות האלה הופכות את ההשוואות לניתנות לפרשנות. הן לא הופכות מערך נתונים אחד לראיה אוניברסלית.</p>
    <div class="methods-grid">{cards.map(([h, p]) => <article><h2>{h}</h2><p>{p}</p></article>)}</div>
    <h2 id="scope">מה המדד יכול לבסס</h2>
    <p>הוא מעריך איך התהליכים הקונקרטיים האלה מתנהגים על מדגם השוואה (ובחלק 16, על רשומות מאוחרות יותר) של מערך הנתונים הזה. את חלק ההשוואה ראינו בטיוטות מוקדמות של הסדרה, ולכן זה מדד הוראה מבוקר ולא סט מבחן חדש. המדד יכול לחשוף רגישות לחלוקה, לנדירות המחלקה, לפונקציות מטרה ולספים. הוא לא יכול לזהות את ההשפעה הסיבתית של יצירת קשר עם אנשים, להוכיח שסדר השורות תואם את לוח השנה, או להכתיר משפחת מודלים לכל בעיה טבלאית.</p>
    <h2 id="artifacts">לבדוק את ההרצה</h2>
    <p>מתחילים ב<a href={art('protocol_manifest.json')}>מניפסט הפרוטוקול</a> (חלוקות, החלטות לגבי תכונות, גרסאות, גרעינים), ב<a href={art('feature_availability.csv')}>טבלת זמינות התכונות</a>, ואז ב<a href={art('leaderboard_selected.csv')}>ההגדרה שנבחרה והציונים של כל מודל</a>, ב<a href={art('leaderboard_candidates.csv')}>כל מועמד שנבדק</a> וב<a href={art('leaderboard_predictions.csv')}>ציוני חלק ההשוואה של שנים-עשר המודלים</a>. העיבוד המקדים יושב בתוך כל תהליך מותאם, כך שמקודדים ומתקננים לומדים רק משורות האימון. הטבלאות והמספרים במאמרים מרונדרים מהקבצים האלה.</p>
  </section>
</BaseLayout>
